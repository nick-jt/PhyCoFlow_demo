+        raise SystemExit(
+            f"[seedcheck] FINGERPRINT MISMATCH at snap 29: got sensors={int(sensors)} "
+            f"idx_sum={int(idx_sum)}, expected sensors={CANONICAL_FP['sensors']} "
+            f"idx_sum={CANONICAL_FP['idx_sum']}. Wrong build_sparse_condition "
